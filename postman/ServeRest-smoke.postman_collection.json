{
  "info": {"name":"ServeRest | Smoke local","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable":[{"key":"baseUrl","value":"http://localhost:3000"},{"key":"adminEmail","value":""},{"key":"adminToken","value":""},{"key":"adminId","value":""},{"key":"productId","value":""}],
  "event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["if (!pm.collectionVariables.get('adminEmail')) { const id = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`; pm.collectionVariables.set('adminEmail', `qa-admin-${id}@qa.com.br`); }"]}}],
  "item":[
    {"name":"TC-USR-001 | Criar administrador sintético","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"nome\": \"QA Admin\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"qa-local-only\",\n  \"administrador\": \"true\"\n}"},"url":"{{baseUrl}}/usuarios"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('201 - administrador criado', () => pm.response.to.have.status(201));","pm.collectionVariables.set('adminId', pm.response.json()._id);"]}}]},
    {"name":"TC-AUTH-001 | Login válido","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"qa-local-only\"\n}"},"url":"{{baseUrl}}/login"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('200 - token emitido', () => pm.response.to.have.status(200));","if (pm.response.code === 200) { const token = pm.response.json().authorization; pm.expect(token).to.include('Bearer '); pm.collectionVariables.set('adminToken', token); }"]}}]},
    {"name":"TC-PRD-001 | Administrador cria produto","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"{{adminToken}}"}],"body":{"mode":"raw","raw":"{\n  \"nome\": \"QA Produto {{adminId}}\",\n  \"preco\": 199,\n  \"descricao\": \"Massa sintética local\",\n  \"quantidade\": 5\n}"},"url":"{{baseUrl}}/produtos"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('201 - produto criado', () => pm.response.to.have.status(201));","pm.collectionVariables.set('productId', pm.response.json()._id);"]}}]},
    {"name":"Limpeza | Excluir produto sintético","request":{"method":"DELETE","header":[{"key":"Authorization","value":"{{adminToken}}"}],"url":"{{baseUrl}}/produtos/{{productId}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('200 - produto removido', () => pm.response.to.have.status(200));"]}}]},
    {"name":"Limpeza | Excluir administrador sintético","request":{"method":"DELETE","header":[],"url":"{{baseUrl}}/usuarios/{{adminId}}"},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('200 - administrador removido', () => pm.response.to.have.status(200));"]}}]}
  ]
}
